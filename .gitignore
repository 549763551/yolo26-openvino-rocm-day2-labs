# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Virtual environments
.venv/
venv/

# Jupyter
.ipynb_checkpoints/
*.ipynb_meta/

# Large artifacts — weights and datasets are never committed
weights/*
!weights/.gitkeep

# data: only the provenance manifest is committed; images are re-downloaded
data/*
!data/manifest.json

# Runtime logs and scratch
logs/
nohup.out
*.part
*.dl

# Ultralytics val/predict scratch outputs
runs/

# Benchmark evidence (small CSV/JSON) IS committed intentionally

# OS / editor
.DS_Store
*.swp
